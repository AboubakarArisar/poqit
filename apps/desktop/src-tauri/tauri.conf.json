{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POQIT",
  "version": "0.1.0",
  "identifier": "app.poqit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "POQIT", "width": 400, "height": 660, "minWidth": 340, "minHeight": 480, "resizable": true, "center": true },
      { "label": "pocket", "title": "POQIT Pocket", "url": "index.html#/pocket", "width": 196, "height": 196, "visible": false, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "shadow": false, "focus": false }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
